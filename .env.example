# ---------------------------------------------------------------------------
# Mesure d'audience — deux couches, deux régimes juridiques.
# Détail : docs/analytics.md
# ---------------------------------------------------------------------------

# Compteurs internes, agrégés, sans cookie ni identifiant : exemptés de
# consentement. Mettre à "1" en production uniquement — en local et en
# préproduction, les passages de test fausseraient les totaux.
NEXT_PUBLIC_AUDIENCE_ENABLED=

# Table DynamoDB des compteurs. Créée par la couche Terraform
# linqfolio-cloud/layers/70-newsletter (voir docs/audience-dynamodb.md).
AUDIENCE_TABLE_NAME=linqfolio-audience

# Identifiant de mesure GA4. Absent, aucune bannière n'est affichée et aucun
# script tiers n'est chargé. Google Analytics ne se charge JAMAIS avant un
# accord explicite : la CNIL ne lui accorde pas l'exemption de consentement.
#
# Les dimensions personnalisées à créer dans GA4 AVANT le premier déploiement
# sont listées dans docs/analytics.md — elles ne sont pas rétroactives.
NEXT_PUBLIC_GA_ID=

# Jeton de vérification Google Search Console, pour la méthode « balise HTML ».
# Inutile si la propriété est vérifiée par enregistrement DNS TXT, ce qui est
# la méthode à préférer : elle couvre le domaine entier et survit aux refontes.
# Voir docs/seo.md.
GOOGLE_SITE_VERIFICATION=
